# Cloudflare Worker production environment template
# Copy this file to a secure local file only. Do not commit real values.

# Public Worker configuration
SITE_URL=https://www.ezsportsnetting.com
MAINTENANCE=false
SEND_WELCOME_EMAIL=false
DAILY_REPORT_ENABLED=false

# Required application settings
ADMIN_EMAILS=admin@example.com
CONTACT_INBOX=info@ezsportsnetting.com
ORDER_NOTIFY_TO=info@ezsportsnetting.com
ALERT_EMAIL_TO=info@ezsportsnetting.com

# Required Worker secrets
JWT_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_replace-me
RESEND_FROM="EZ Sports Netting <orders@ezsportsnetting.com>"

# Required for live Stripe checkout
STRIPE_PUBLISHABLE_KEY=pk_live_replace-me
STRIPE_SECRET_KEY=sk_live_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Optional Cloudflare protection and integrations
TURNSTILE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=

# GitHub Actions deployment secrets are configured in GitHub,
# not as Worker runtime variables:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
